# ratethat.tennis — Environment variables
# Copy to .env and fill in values

# PostgreSQL connection string (Railway)
DATABASE_URL=postgresql://postgres:PASSWORD@switchyard.proxy.rlwy.net:39343/railway

# CORS origins (comma-separated) — add your frontend domain
CORS_ORIGINS=https://ratethat.tennis,http://localhost:3000

# API Tennis key (for live match data pipeline)
API_TENNIS_KEY=your_api_key_here

# Anthropic API key (for intelligence generation — run_intelligence.command)
ANTHROPIC_API_KEY=sk-ant-...
